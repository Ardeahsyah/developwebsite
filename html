            <div class="js-line"></div>

            <div class="js-step">
                <span>04</span>
                <strong>Display</strong>
                <p>Update KPIs, cards and tables.</p>
            </div>

        </div>

    </section>


    <!-- INTERACTIVE CALCULATOR -->
    <section class="content-section">

        <div class="section-heading">
            <span class="section-number">08</span>

            <div>
                <div class="section-eyebrow">TRY IT YOURSELF</div>
                <h2>Performance Calculator</h2>
            </div>
        </div>


        <div class="calculator-panel">

            <div class="calculator-inputs">

                <div class="input-group">
                    <label>Number of PE Staff</label>
                    <input
                        id="totalStaff"
                        type="number"
                        value="6"
                        min="1"
                    >
                </div>

                <div class="input-group">
                    <label>Staff Enrolled</label>
                    <input
                        id="staffEnrolled"
                        type="number"
                        value="5"
                        min="0"
                        max="6"
                    >
                </div>

                <div class="input-group">
                    <label>Staff Certified</label>
                    <input
                        id="staffCertified"
                        type="number"
                        value="4"
                        min="0"
                        max="6"
                    >
                </div>

            </div>


            <div class="calculator-results">

                <div class="calculator-result">

                    <span>ENROLMENT</span>

                    <strong id="enrolmentResult">
                        83.3%
                    </strong>

                    <div class="calculator-bar">
                        <div
                            id="enrolmentBar"
                            class="calculator-fill blue"
                            style="width:83.3%">
                        </div>
                    </div>

                </div>


                <div class="calculator-result">

                    <span>CERTIFICATION</span>

                    <strong id="certificationResult">
                        66.7%
                    </strong>

                    <div class="calculator-bar">
                        <div
                            id="certificationBar"
                            class="calculator-fill green"
                            style="width:66.7%">
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>


