    <!-- ARCHITECTURE -->
    <section class="content-section architecture-section">

        <div class="section-heading">
            <span class="section-number">02</span>

            <div>
                <div class="section-eyebrow">SOLUTION ARCHITECTURE</div>
                <h2>How Does the Solution Work?</h2>
            </div>
        </div>


        <div class="architecture-flow">

            <div class="architecture-card">
                <div class="architecture-step">STEP 1</div>
                <div class="architecture-icon">ML</div>
                <h3>Microsoft Lists</h3>
                <p>Store PE training records.</p>

                <div class="architecture-role">
                    DATA SOURCE
                </div>
            </div>


            <div class="architecture-arrow">
                <span>→</span>
            </div>


            <div class="architecture-card">
                <div class="architecture-step">STEP 2</div>
                <div class="architecture-icon architecture-icon-red">PA</div>
                <h3>Power Automate</h3>
                <p>Retrieve records from the list.</p>

                <div class="architecture-role">
                    INTEGRATION
                </div>
            </div>


            <div class="architecture-arrow">
                <span>→</span>
            </div>


            <div class="architecture-card">
                <div class="architecture-step">STEP 3</div>
                <div class="architecture-icon architecture-icon-gold">{ }</div>
