    <!-- CASE STUDY -->
    <section class="content-section">

        <div class="section-heading">
            <span class="section-number">03</span>

            <div>
                <div class="section-eyebrow">CASE STUDY</div>
                <h2>The Business Requirement</h2>
            </div>
        </div>


        <div class="case-grid">

            <div class="case-card">

                <div class="case-card-label">THE PROBLEM</div>

                <h3>We have training records.</h3>

                <p>
                    But raw training records alone do not immediately tell us
                    how the overall PE team is progressing.
                </p>

            </div>


            <div class="case-card">

                <div class="case-card-label">THE QUESTION</div>

                <h3>What do we want to know?</h3>

                <ul>
                    <li>Who has enrolled?</li>
                    <li>Who has been certified?</li>
                    <li>Which training was attended?</li>
                    <li>What is the overall PE completion rate?</li>
                </ul>

            </div>


            <div class="case-card case-card-highlight">

                <div class="case-card-label">THE SOLUTION</div>

                <h3>Convert data into insight.</h3>

                <p>
                    Create an automated training monitoring page that calculates
                    performance directly from the underlying records.
                </p>

            </div>

        </div>

    </section>


    <!-- DATA MODEL -->
    <section class="content-section">

        <div class="section-heading">
            <span class="section-number">04</span>

            <div>
                <div class="section-eyebrow">UNDERSTANDING THE DATA</div>
                <h2>Start With the Data Structure</h2>
            </div>
        </div>


        <div class="learning-note">
            <strong>Process Excellence Principle</strong>
            <p>
                Before automating a process, understand what information
                is being captured and what each field means.
            </p>
        </div>


        <div class="data-table-wrapper">

            <table class="training-table">

                <thead>
                    <tr>
                        <th>Field</th>
                        <th>Purpose</th>
                        <th>Example</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Training</td>
                        <td>Name of training programme</td>
                        <td>Train the Trainer</td>
                    </tr>

                    <tr>
                        <td>PE Staffs</td>
                        <td>Staff attending the programme</td>
                        <td>Ardeahsyah</td>
                    </tr>

                    <tr>
                        <td>Enrollment?</td>
                        <td>Whether staff enrolled</td>
                        <td>Yes</td>
                    </tr>

                    <tr>
                        <td>Certified?</td>
                        <td>Whether certification was achieved</td>
                        <td>Yes</td>
                    </tr>

                    <tr>
                        <td>Training Start Date</td>
                        <td>Programme start date</td>
                        <td>Date</td>
                    </tr>

                    <tr>
                        <td>Training End Date</td>
                        <td>Programme completion date</td>
                        <td>Date</td>
                    </tr>

                    <tr>
                        <td>Training Provider</td>
                        <td>Training organisation</td>
                        <td>Provider</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>


    <!-- PERFORMANCE LOGIC -->
    <section class="content-section">

        <div class="section-heading">
            <span class="section-number">05</span>

            <div>
                <div class="section-eyebrow">BUSINESS LOGIC</div>
                <h2>Translate Requirements Into Formulas</h2>
            </div>
        </div>


        <div class="formula-grid">

            <div class="formula-card">

                <div class="formula-title">
                    ENROLMENT PERFORMANCE
                </div>

                <div class="formula-main">
                    <span># Staff Enrolled</span>

                    <div class="fraction-line"></div>

                    <span>6 PE Staff</span>
                </div>

                <div class="formula-example">
                    Example:
                    <strong>5 ÷ 6 = 83.3%</strong>
                </div>

            </div>


            <div class="formula-card">

                <div class="formula-title">
                    CERTIFICATION PERFORMANCE
                </div>

                <div class="formula-main">
                    <span># Staff Certified</span>

                    <div class="fraction-line"></div>

                    <span>6 PE Staff</span>
                </div>

                <div class="formula-example">
                    Example:
                    <strong>4 ÷ 6 = 66.7%</strong>
                </div>

            </div>

        </div>


        <div class="important-box">

            <div class="important-icon">!</div>

            <div>
                <strong>Important Concept: Count People, Not Records</strong>

                <p>
                    One staff member could attend multiple training programmes.
                    Therefore, overall coverage should use unique staff rather
                    than simply counting the number of training records.
                </p>
            </div>

        </div>

    </section>


    <!-- POWER AUTOMATE LAB -->
    <section class="content-section">

        <div class="section-heading">
            <span class="section-number">06</span>

            <div>
                <div class="section-eyebrow">HANDS-ON LAB</div>
                <h2>Build the Power Automate Flow</h2>
            </div>
        </div>


        <div class="lab-container">

            <div class="lab-progress">

                <button class="lab-step active" data-step="1">
                    <span>1</span>
                    Trigger
                </button>

                <button class="lab-step" data-step="2">
                    <span>2</span>
                    Get Items
                </button>

                <button class="lab-step" data-step="3">
                    <span>3</span>
                    Prepare Data
                </button>

                <button class="lab-step" data-step="4">
                    <span>4</span>
                    Return Data
                </button>

                <button class="lab-step" data-step="5">
                    <span>5</span>
                    Connect
                </button>

            </div>


            <div class="lab-content">


                <!-- STEP 1 -->

                <div class="lab-panel active" data-panel="1">

                    <div class="lab-tag">STEP 1</div>

                    <h3>Create the Power Pages Trigger</h3>

                    <p>
                        Start the cloud flow from Power Pages. This creates
                        the entry point that the website will later call.
                    </p>

                    <div class="flow-example">

                        <div class="flow-box">
                            <small>POWER PAGES</small>
                            <strong>When Power Pages calls a flow</strong>
                        </div>

                    </div>

                    <div class="lab-question">
                        <strong>Think about it</strong>
                        <p>
                            Why do we need an integration layer instead of
                            placing our business logic directly inside the webpage?
                        </p>
                    </div>

                </div>


                <!-- STEP 2 -->

                <div class="lab-panel" data-panel="2">

                    <div class="lab-tag">STEP 2</div>

                    <h3>Retrieve the Training Records</h3>

                    <p>
                        Add the SharePoint action that retrieves the records
                        maintained in the PE Training Record list.
                    </p>

                    <div class="flow-example">

                        <div class="flow-box">
                            <small>POWER PAGES</small>
                            <strong>When Power Pages calls a flow</strong>
                        </div>

                        <div class="flow-down">↓</div>

                        <div class="flow-box flow-box-green">
                            <small>SHAREPOINT</small>
                            <strong>Get items</strong>
                        </div>

                    </div>

                </div>


                <!-- STEP 3 -->

                <div class="lab-panel" data-panel="3">

                    <div class="lab-tag">STEP 3</div>

                    <h3>Prepare the Data</h3>

                    <p>
                        Keep only the information required by the website.
                        This makes the response easier for JavaScript to process.
                    </p>

                    <div class="code-example">
<pre>{
  "training": "...",
  "staff": "...",
  "enrolled": true,
  "certified": true,
  "startDate": "...",
  "endDate": "...",
  "provider": "..."
}</pre>
                    </div>

                </div>


                <!-- STEP 4 -->

                <div class="lab-panel" data-panel="4">

                    <div class="lab-tag">STEP 4</div>

                    <h3>Return the Data</h3>

                    <p>
                        The flow needs to return the prepared information
                        to the Power Pages webpage.
                    </p>

                    <div class="flow-example">

                        <div class="flow-box">
                            <small>POWER AUTOMATE</small>
                            <strong>Training Records</strong>
                        </div>

                        <div class="flow-down">↓</div>

                        <div class="flow-box flow-box-gold">
                            <small>OUTPUT</small>
                            <strong>JSON Response</strong>
                        </div>

                    </div>

                </div>


                <!-- STEP 5 -->

                <div class="lab-panel" data-panel="5">

                    <div class="lab-tag">STEP 5</div>

                    <h3>Connect Power Pages</h3>

                    <p>
                        JavaScript receives the response, performs the
                        required calculations and updates the webpage.
                    </p>

                    <div class="flow-example horizontal">

                        <div class="flow-box flow-box-gold">
                            <small>DATA</small>
                            <strong>JSON</strong>
                        </div>

                        <div class="horizontal-arrow">→</div>

                        <div class="flow-box">
                            <small>LOGIC</small>
                            <strong>JavaScript</strong>
                        </div>

                        <div class="horizontal-arrow">→</div>

                        <div class="flow-box flow-box-green">
                            <small>OUTPUT</small>
                            <strong>Dashboard</strong>
                        </div>

                    </div>

                </div>

            </div>


            <div class="lab-navigation">

                <button id="previousStep" class="secondary-button">
                    ← Previous
                </button>

                <span id="stepIndicator">
                    Step 1 of 5
                </span>

                <button id="nextStep" class="primary-button">
                    Next →
                </button>

            </div>

        </div>

    </section>


    <!-- JAVASCRIPT CONCEPT -->
    <section class="content-section">

        <div class="section-heading">
            <span class="section-number">07</span>

